{
  "name": "@surf-check/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "corepack pnpm --filter @surf-check/shared build && tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "corepack pnpm --filter @surf-check/shared build && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@surf-check/shared": "workspace:*",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^6.3.5"
  }
}
